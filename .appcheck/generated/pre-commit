#!/bin/bash
# appcheck Pre-Commit Hook — Generated by Step 15
# Runs fast gates only: Dependencies (1), Syntax/Lint (4), Environment (5), Port/Timezone (11)
# Full pipeline runs in CI; this hook blocks commits with basic failures only.

set -e

echo "🔍 appcheck pre-commit: Running fast gates..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

# Step 1: Quick Dependency Check
echo -e "${YELLOW}[1/4] Dependencies...${NC}"
if [ -f package.json ]; then
  if ! npm ls --all >/dev/null 2>&1; then
    echo -e "${RED}❌ Dependency tree broken${NC}"
    FAILED=1
  else
    echo -e "${GREEN}✅ Dependencies OK${NC}"
  fi
fi

# Step 4: Syntax & Lint
echo -e "${YELLOW}[2/4] Syntax & Lint...${NC}"
if [ -f package.json ] && grep -q '"lint"' package.json; then
  if ! npm run lint >/dev/null 2>&1; then
    echo -e "${RED}❌ Lint failed${NC}"
    FAILED=1
  else
    echo -e "${GREEN}✅ Lint passed${NC}"
  fi
elif [ -f eslint.config.js ] || [ -f .eslintrc.js ]; then
  if ! npx eslint scripts/**/*.js api/**/*.js >/dev/null 2>&1; then
    echo -e "${RED}❌ ESLint failed${NC}"
    FAILED=1
  else
    echo -e "${GREEN}✅ ESLint passed${NC}"
  fi
fi

# Quick JS syntax check
for f in api/*.js scripts/*.js; do
  if [ -f "$f" ]; then
    node --check "$f" 2>/dev/null || {
      echo -e "${RED}❌ Syntax error in $f${NC}"
      FAILED=1
    }
  fi
done

# Step 5: Environment Check
echo -e "${YELLOW}[3/4] Environment...${NC}"
if [ -f .env.example ]; then
  echo -e "${GREEN}✅ .env.example present${NC}"
else
  echo -e "${YELLOW}⚠️ .env.example missing${NC}"
fi

# Check for hardcoded secrets (basic pattern, exclude comments & placeholders)
if grep -r "sk_\|pk_\|api_key\|secret" --include="*.js" --include="*.ts" --exclude-dir=node_modules . 2>/dev/null | grep -v ".env.example" | grep -v ".git" | grep -v "//" | grep -v "REDACTED" | grep -v "sb_secret_" | grep -v "your_" | grep -v "placeholder" >/dev/null 2>&1; then
  echo -e "${RED}❌ Potential secrets in code${NC}"
  FAILED=1
else
  echo -e "${GREEN}✅ No obvious secrets${NC}"
fi

# Step 11: Port & Timezone
echo -e "${YELLOW}[4/4] Port & Timezone...${NC}"
for port in 3000 4000 5000 8080 8765 2283; do
  if ss -tln 2>/dev/null | grep -q ":$port "; then
    echo -e "${YELLOW}⚠️ Port $port in use (may conflict)${NC}"
  fi
done
echo -e "${GREEN}✅ Port check complete${NC}"

# Final result
if [ $FAILED -eq 1 ]; then
  echo -e "${RED}❌ appcheck pre-commit: FAILED — commit blocked${NC}"
  echo "Run 'appcheck /path/to/app' for full diagnostic."
  exit 1
else
  echo -e "${GREEN}✅ appcheck pre-commit: PASSED${NC}"
  exit 0
fi