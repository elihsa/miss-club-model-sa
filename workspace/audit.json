  "envVars": [
    "CANDIDATE_EMAIL",
    "EVENT_EMAIL",
    "GLOBAL_EMAIL",
    "RESEND_API_KEY",
    "SUPABASE_SERVICE_KEY",
    "SUPABASE_URL",
    "VENUE_EMAIL"
  ],
  "tables": [
    {
      "name": "applications",
      "columns": [
        "created_at",
        "data",
        "email",
        "full_name",
        "phone",
        "platform"
      ]
    },
    {
      "name": "event_interest_subscriptions",
      "columns": [
        "data",
        "email",
        "event_id",
        "favorite_candidate",
        "full_name",
        "phone"
      ]
    },
    {
      "name": "event_organizers",
      "columns": [
        "availability",
        "capacity",
        "data",
        "email",
        "equipment",
        "full_name",
        "phone",
        "terms_accepted",
        "venue_address",
        "venue_description",
        "venue_location",
        "venue_name",
        "website_url"
      ]
    },
    {
      "name": "events",
      "columns": [
        "data",
        "email",
        "event_id",
        "favorite_candidate",
        "full_name",
        "phone"
      ]
    },
    {
      "name": "interested_parties",
      "columns": [
        "data",
        "email",
        "event_id",
        "favorite_candidate",
        "full_name",
        "phone"
      ]
    },
    {
      "name": "site_settings",
      "columns": [
        "data",
        "value"
      ]
    },
    {
      "name": "videos",
      "columns": []
    }
  ],
  "storage": {
    "buckets": [
      "events",
      "videos"
    ]
  },
  "deployment": {
    "version": 2,
    "public": true,
    "cleanUrls": true,
    "trailingSlash": false,
    "buildCommand": "npm run build",
    "devCommand": "vercel dev",
    "installCommand": "npm install",
    "framework": null,
    "outputDirectory": ".",
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/design-system",
        "destination": "/design-system-builder.html"
      }
    ]
  },
  "cms": {
    "google_sheet_url": "https://docs.google.com/spreadsheets/d/e/2PACX-1vTfyDuaZ3UGKmMCNsKGYwG0oqfADQJMcNnrWkt0qYjhjTuNWL0LTGpWM-WORdoz10AW7P1_QxJNW2G_/pub?gid=1299416052&single=true&output=csv"
  }
}